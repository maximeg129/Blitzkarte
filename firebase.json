{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/generateSet", "function": { "functionId": "generateSet", "region": "europe-west1" } },
      { "source": "/api/checkWriting", "function": { "functionId": "checkWriting", "region": "europe-west1" } }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
